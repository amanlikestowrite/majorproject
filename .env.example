# Express Application Gateway Environment Configuration

# Server Settings
PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

# Database Connection (Supabase PostgreSQL)
DATABASE_URL="postgres://postgres.ympotjelgfjpnehozumm:[YOUR_DB_PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgres://postgres.ympotjelgfjpnehozumm:[YOUR_DB_PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres"

# Python AI Microservice (FastAPI Port 8000)
AI_SERVICE_URL=http://127.0.0.1:8000
# Shared Internal Secret for Express-to-FastAPI authentication (forwarded via X-Internal-Service-Key; must match FastAPI's INTERNAL_SERVICE_TOKEN)
INTERNAL_AI_SECRET=replace_with_shared_internal_gateway_secret

# Google OAuth 2.0 Client Credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Session Lifecycles
GUEST_SESSION_TTL_HOURS=24
AUTH_SESSION_TTL_DAYS=7
