# Server Configuration
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
# Internal Service Security Token (Protects FastAPI endpoints from unauthorized external requests)
# Set a strong secret in production; Express forwards this via X-Internal-Service-Key or Authorization Bearer
INTERNAL_SERVICE_TOKEN=your_secure_internal_token_here

# Vector Database Configuration
VECTOR_STORE_TYPE=qdrant
# Mode options: 'embedded' (local on-disk storage) or 'cloud' (hosted Qdrant Cloud cluster)
VECTOR_STORE_MODE=embedded
QDRANT_STORAGE_PATH=./qdrant_storage
QDRANT_COLLECTION_NAME=doj_knowledge_base
# Qdrant Cloud Configuration (Required when VECTOR_STORE_MODE=cloud)
# QDRANT_URL=https://your-cluster-id.region.gcp.cloud.qdrant.io:6333
# QDRANT_API_KEY=your_qdrant_cloud_api_key_here

# Embedding Model Configuration
# Provider options: 'local' (BAAI/bge-m3), 'gemini' (gemini-embedding-001), 'huggingface'
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=1024

# Google Gemini Hosted Embedding Configuration (Active when EMBEDDING_PROVIDER=gemini)
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768

# Hosted Hugging Face Inference Configuration (Required when EMBEDDING_PROVIDER=huggingface)
HF_TOKEN=your_huggingface_token_here
HF_API_URL=https://router.huggingface.co/hf-inference/models/BAAI/bge-m3
HF_TIMEOUT_SECONDS=30.0
HF_MAX_RETRIES=3

# Data & Knowledge Base Paths
KNOWLEDGE_BASE_CHUNKS_PATH=./data/knowledge_base/rag_chunks.jsonl
METADATA_INDEX_PATH=./data/knowledge_base/master_metadata_index.json

# Retrieval Parameters
DEFAULT_TOP_K=3
SCORE_THRESHOLD=0.45

# Google Gemini RAG Configuration (Server-side only — never commit your real key)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TIMEOUT_SECONDS=30.0

