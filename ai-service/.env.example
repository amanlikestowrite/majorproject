# Server Configuration
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Vector Database Configuration
VECTOR_STORE_TYPE=qdrant
QDRANT_STORAGE_PATH=./qdrant_storage
QDRANT_COLLECTION_NAME=doj_knowledge_base

# Embedding Model Configuration
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=1024

# Data & Knowledge Base Paths
KNOWLEDGE_BASE_CHUNKS_PATH=./data/knowledge_base/rag_chunks.jsonl
METADATA_INDEX_PATH=./data/knowledge_base/master_metadata_index.json

# Retrieval Parameters
DEFAULT_TOP_K=3
SCORE_THRESHOLD=0.45

# Google Gemini RAG Configuration (Server-side only — never commit your real key)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_TIMEOUT_SECONDS=30.0

